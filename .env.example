# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings > API no painel do Supabase).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Chave pública VAPID gerada com `npx web-push generate-vapid-keys`.
# A chave PRIVADA vai nos Secrets da Edge Function do Supabase, nunca aqui.
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
